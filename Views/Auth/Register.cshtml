@model LearningManagement.ViewModels.RegisterViewModel

@{
    ViewBag.Title = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        --primary-hover: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
        --bg-gradient: radial-gradient(circle at 50% 0%, #eef2ff 0%, #f8fafc 100%);
        --card-shadow: 0 30px 60px -12px rgba(0, 0, 0, 0.15), 0 0 20px rgba(0, 0, 0, 0.04);
        --icon-bg: #eef2ff;
    }

    body {
        background: var(--bg-gradient);
        min-height: 100vh;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: #1e293b;
        font-size: 1.6rem; /* Ultra-Massive baseline font size */
    }

    .registration-wrapper {
        min-height: calc(100vh - 80px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 5rem 1rem;
    }

    .registration-card {
        background: #ffffff;
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: 40px; /* Enormous soft corners */
        box-shadow: var(--card-shadow);
        max-width: 960px; /* Widened further for massive inputs */
        width: 100%;
        overflow: hidden;
        transition: transform 0.3s ease;
    }

    .card-header-accent {
        height: 14px;
        background: var(--primary-gradient);
    }

    .form-section {
        padding: 6rem 5rem; /* Ultra-Massive padding */
    }

    /* Icon Badge Container */
    .form-icon-wrapper {
        width: 130px;
        height: 130px;
        background: var(--icon-bg);
        border-radius: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 2.5rem;
    }

        .form-icon-wrapper i {
            font-size: 4.5rem !important; /* Ultra-Massive Icon */
        }

    /* Headers */
    .form-header-title {
        font-size: 3.75rem; /* Ultra-Massive Title */
        font-weight: 800;
        letter-spacing: -0.03em;
        margin-bottom: 1rem;
    }

    .form-header-subtitle {
        font-size: 1.6rem;
        color: #64748b;
    }

    /* Section Subheadings */
    .form-section-title {
        font-size: 1.4rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-weight: 800;
        color: #94a3b8;
        margin-bottom: 1.5rem;
        margin-top: 2.5rem;
    }

    /* Floating Labels & Form Controls (Ultra-Massive) */
    .form-floating > .form-control,
    .form-floating > .form-select {
        border-radius: 20px;
        border: 3px solid #e2e8f0;
        background-color: #f8fafc;
        height: 96px; /* Ultra-Massive inputs */
        color: #0f172a;
        font-weight: 700;
        font-size: 1.75rem; /* Ultra-Massive text */
        transition: all 0.2s ease-in-out;
    }

    .form-floating > label {
        color: #64748b;
        padding-left: 1.75rem;
        font-size: 1.5rem; /* Ultra-Massive Label */
        padding-top: 1.75rem;
    }

    .form-floating > .form-control:focus,
    .form-floating > .form-select:focus {
        background-color: #ffffff;
        border-color: #6366f1;
        box-shadow: 0 0 0 6px rgba(99, 102, 241, 0.15);
        outline: none;
    }

    .form-floating > .form-control::placeholder {
        color: transparent;
    }

    /* Primary Button (Ultra-Massive) */
    .btn-register {
        background: var(--primary-gradient);
        border: none;
        border-radius: 24px;
        padding: 1.75rem;
        font-weight: 800;
        font-size: 1.75rem;
        letter-spacing: 0.02em;
        box-shadow: 0 14px 28px -6px rgba(99, 102, 241, 0.45);
        transition: all 0.25s ease;
        width: 100%;
    }

        .btn-register:hover {
            background: var(--primary-hover);
            transform: translateY(-4px);
            box-shadow: 0 20px 35px -6px rgba(99, 102, 241, 0.55);
        }

        .btn-register:active {
            transform: translateY(0);
        }

    /* Link Styling */
    .login-link-container {
        font-size: 1.5rem;
        color: #64748b;
        font-weight: 600;
    }

    .login-link {
        color: #6366f1;
        font-weight: 800;
        transition: color 0.2s ease;
        margin-left: 0.5rem;
    }

        .login-link:hover {
            color: #4338ca;
            text-decoration: underline !important;
        }

    /* Validation Errors */
    .field-validation-error {
        font-size: 1.3rem;
        margin-top: 0.6rem;
        display: block;
        font-weight: 700;
        color: #ef4444;
    }

    /* Responsive Breakdown */
    @@media (max-width: 991px) {
        .registration-card {
            border-radius: 32px;
        }

        .form-section {
            padding: 4rem 3rem;
        }

        .form-header-title {
            font-size: 3.25rem;
        }
    }

    @@media (max-width: 768px) {
        .registration-wrapper {
            padding: 2rem 0.5rem;
        }

        .form-section {
            padding: 3rem 2rem;
        }

        .form-floating > .form-control,
        .form-floating > .form-select {
            height: 86px;
            font-size: 1.5rem;
        }

        .form-floating > label {
            font-size: 1.35rem;
            padding-top: 1.5rem;
        }

        .form-header-title {
            font-size: 2.75rem;
        }

        .btn-register {
            padding: 1.5rem;
            font-size: 1.5rem;
        }
    }
</style>

<div class="registration-wrapper">
    <div class="registration-card">
        <div class="card-header-accent"></div>
        <div class="form-section">

            <div class="text-center mb-5 pb-3">
                <div class="form-icon-wrapper">
                    <i class="bi bi-person-plus-fill text-indigo" style="color: #6366f1;"></i>
                </div>
                <h3 class="form-header-title text-dark">Create an Account</h3>
                <p class="text-muted form-header-subtitle mb-0">Fill in your details below to get started</p>
            </div>

            @using (Html.BeginForm("Register", "Auth", FormMethod.Post, new { id = "registerForm" }))
            {
                @Html.AntiForgeryToken()

                if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger border-0 rounded-4 py-4 px-5 mb-5 d-flex align-items-center" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-4 fs-1 text-danger"></i>
                        <div class="fw-bold fs-4">
                            @Html.ValidationSummary(true, "Please resolve the highlighted errors:")
                        </div>
                    </div>
                }

                <!-- Personal Information -->
                <div class="form-section-title mt-0">Personal Details</div>
                <div class="row g-4 mb-4">
                    <div class="col-12 col-md-6">
                        <div class="form-floating">
                            <label for="fname">Full Name</label>
                            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", id = "fname", placeholder = "John Doe" })
                        </div>
                        @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger ms-1" })
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="form-floating">
                            <label for="femail">Email Address</label>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", id = "femail", placeholder = "name@example.com" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger ms-1" })
                    </div>
                </div>

                <!-- Account Security -->
                <div class="form-section-title">Security & Credentials</div>
                <div class="row g-4 mb-4">
                    <div class="col-12 col-md-6">
                        <div class="form-floating">
                            <label for="fpass">Password</label>
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", id = "fpass", placeholder = "Password" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger ms-1" })
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="form-floating">
                            <label for="fcpass">Confirm Password</label>
                            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", id = "fcpass", placeholder = "Confirm Password" }) 
                        </div>
                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger ms-1" })
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-12 col-md-6">
                        <div class="form-floating">
                            <label for="fsq">Security Question</label>
                            @Html.TextBoxFor(m => m.SecurityQuestion, new { @class = "form-control", id = "fsq", placeholder = "Security Question" })
                        </div>
                        @Html.ValidationMessageFor(m => m.SecurityQuestion, "", new { @class = "text-danger ms-1" })
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="form-floating">
                            <label for="fsa">Secret Answer</label>
                            @Html.TextBoxFor(m => m.SecurityAnswer, new { @class = "form-control", id = "fsa", placeholder = "Secret Answer" })
                        </div>
                        @Html.ValidationMessageFor(m => m.SecurityAnswer, "", new { @class = "text-danger ms-1" })
                    </div>
                </div>

                <!-- Account Role -->
                <div class="form-section-title">Account Type</div>
                <div class="form-floating mb-5 pb-3">
                    <label for="frole">Role</label>
                    @Html.DropDownListFor(m => m.RoleId, (SelectList)ViewBag.RoleId, "Select an option...", new { @class = "form-select", id = "frole" })
                    @Html.ValidationMessageFor(m => m.RoleId, "", new { @class = "text-danger ms-1" })
                </div>

                <div class="d-grid pt-4">
                    <button type="submit" class="btn btn-register text-white d-inline-flex align-items-center justify-content-center gap-4">
                        <span>Create Account</span>
                        <i class="bi bi-arrow-right fs-2"></i>
                    </button>
                </div>
            }

            <div class="mt-5 pt-5 border-top border-3 border-light text-center">
                <p class="login-link-container mb-0">
                    Already have an account?
                    @Html.ActionLink("Log In", "Login", "Auth", null, new { @class = "login-link text-decoration-none" })
                </p>
            </div>
        </div>
    </div>
</div>
