@model LearningManagement.ViewModels.ForgotPasswordViewModel

@{
    ViewBag.Title = "Forgot Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        --primary-hover: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
        --bg-gradient: radial-gradient(circle at 50% 0%, #eef2ff 0%, #f8fafc 100%);
        --card-shadow: 0 30px 60px -12px rgba(0, 0, 0, 0.15), 0 0 20px rgba(0, 0, 0, 0.04);
        --icon-bg: #eef2ff;
        --question-bg: #f0f3ff;
    }

    body {
        background: var(--bg-gradient);
        min-height: 100vh;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: #1e293b;
        font-size: 1.6rem; /* Ultra-Massive baseline font size */
    }

    .forgot-wrapper {
        min-height: calc(100vh - 80px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 5rem 1rem;
    }

    .forgot-card {
        background: #ffffff;
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: 40px; /* Enormous soft corners */
        box-shadow: var(--card-shadow);
        max-width: 760px; /* Widened to match Login view */
        width: 100%;
        overflow: hidden;
        transition: transform 0.3s ease;
    }

    .card-header-accent {
        height: 14px;
        background: var(--primary-gradient);
    }

    .form-section {
        padding: 6rem 5rem; /* Ultra-Massive padding */
    }

    /* Icon Badge Container */
    .brand-icon-wrapper {
        width: 130px;
        height: 130px;
        background: var(--icon-bg);
        border-radius: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 2.5rem;
    }

        .brand-icon-wrapper i {
            font-size: 4.5rem !important; /* Ultra-Massive Icon */
        }

    /* Headers */
    .form-header-title {
        font-size: 3.75rem; /* Ultra-Massive Title */
        font-weight: 800;
        letter-spacing: -0.03em;
        margin-bottom: 1rem;
    }

    .form-header-subtitle {
        font-size: 1.6rem;
        color: #64748b;
    }

    /* Floating Labels & Form Controls (Ultra-Massive) */
    .form-floating > .form-control {
        border-radius: 20px;
        border: 3px solid #e2e8f0;
        background-color: #f8fafc;
        height: 96px; /* Ultra-Massive inputs */
        color: #0f172a;
        font-weight: 700;
        font-size: 1.75rem; /* Ultra-Massive text */
        transition: all 0.2s ease-in-out;
    }

    .form-floating > label {
        color: #64748b;
        padding-left: 1.75rem;
        font-size: 1.5rem; /* Ultra-Massive Label */
        padding-top: 1.75rem;
    }

    .form-floating > .form-control:focus {
        background-color: #ffffff;
        border-color: #6366f1;
        box-shadow: 0 0 0 6px rgba(99, 102, 241, 0.15);
        outline: none;
    }

    .form-floating > .form-control::placeholder {
        color: transparent;
    }

    /* Security Question Card (Massive) */
    .security-question-box {
        background-color: var(--question-bg);
        border-left: 6px solid #6366f1;
        padding: 2rem 2.5rem;
        border-radius: 20px;
        margin-bottom: 3rem;
    }

    .security-question-title {
        color: #6366f1;
        letter-spacing: 0.1em;
        font-size: 1.25rem;
        text-transform: uppercase;
        font-weight: 800;
        margin-bottom: 0.5rem;
    }

    /* Primary Button (Ultra-Massive) */
    .btn-custom {
        background: var(--primary-gradient);
        border: none;
        border-radius: 24px;
        padding: 1.75rem;
        font-weight: 800;
        font-size: 1.75rem;
        letter-spacing: 0.02em;
        box-shadow: 0 14px 28px -6px rgba(99, 102, 241, 0.45);
        transition: all 0.25s ease;
        width: 100%;
        color: #ffffff;
    }

        .btn-custom:hover {
            background: var(--primary-hover);
            transform: translateY(-4px);
            box-shadow: 0 20px 35px -6px rgba(99, 102, 241, 0.55);
            color: #ffffff;
        }

        .btn-custom:active {
            transform: translateY(0);
        }

    /* Link Styling */
    .login-link-container {
        font-size: 1.5rem;
        color: #64748b;
        font-weight: 600;
    }

    .auth-link {
        color: #6366f1;
        font-weight: 800;
        transition: color 0.2s ease;
        margin-left: 0.5rem;
    }

        .auth-link:hover {
            color: #4338ca;
            text-decoration: underline !important;
        }

    /* Validation Errors */
    .field-validation-error {
        font-size: 1.3rem;
        margin-top: 0.6rem;
        display: block;
        font-weight: 700;
        color: #ef4444;
    }

    /* Responsive Breakdown */
    @@media (max-width: 991px) {
        .forgot-card {
            border-radius: 32px;
        }

        .form-section {
            padding: 4rem 3rem;
        }

        .form-header-title {
            font-size: 3.25rem;
        }
    }

    @@media (max-width: 768px) {
        .forgot-wrapper {
            padding: 2rem 0.5rem;
        }

        .form-section {
            padding: 3rem 2rem;
        }

        .form-floating > .form-control {
            height: 86px;
            font-size: 1.5rem;
        }

        .form-floating > label {
            font-size: 1.35rem;
            padding-top: 1.5rem;
        }

        .form-header-title {
            font-size: 2.75rem;
        }

        .btn-custom {
            padding: 1.5rem;
            font-size: 1.5rem;
        }
    }
</style>

<div class="forgot-wrapper">
    <div class="forgot-card">
        <div class="card-header-accent"></div>
        <div class="form-section">

            <div class="text-center mb-5 pb-3">
                <div class="brand-icon-wrapper">
                    <i class="bi bi-shield-lock-fill text-indigo" style="color: #6366f1;"></i>
                </div>
                <h3 class="form-header-title text-dark">Forgot Password?</h3>
                <p class="text-muted form-header-subtitle mb-0">Recover access to your account securely</p>
            </div>

            @using (Html.BeginForm("ForgotPassword", "Auth", FormMethod.Post, new { id = "forgotPasswordForm" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.IsEmailVerified)

                if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger border-0 rounded-4 py-4 px-5 mb-5 d-flex align-items-center" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-4 fs-1 text-danger"></i>
                        <div class="fw-bold fs-4">
                            @Html.ValidationSummary(true, "Please resolve the highlighted errors:")
                        </div>
                    </div>
                }

                if (!Model.IsEmailVerified)
                {
                    <p class="text-muted text-center mb-5 fs-4 fw-medium">Enter your email address to look up your security details.</p>

                    <div class="form-floating mb-5 pb-2">
                        <!-- Input must be BEFORE label for Bootstrap floating labels -->
                        <label for="femail">Email Address</label>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", id = "femail", placeholder = "name@example.com" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger ms-1" })
                    </div>

                    <div class="d-grid pt-3">
                        <button type="submit" class="btn btn-custom d-inline-flex align-items-center justify-content-center gap-3">
                            <span>Verify Email</span>
                            <i class="bi bi-arrow-right fs-2"></i>
                        </button>
                    </div>
                }
                else
                {
                    @Html.HiddenFor(m => m.Email)
                    @Html.HiddenFor(m => m.SecurityQuestion)

                    <div class="security-question-box">
                        <div class="security-question-title">Security Question</div>
                        <p class="fw-bold text-dark mb-0" style="font-size: 2rem;">@Model.SecurityQuestion</p>
                    </div>

                    <div class="form-floating mb-5 pb-2">
                        <!-- Input must be BEFORE label for Bootstrap floating labels -->
                        <label for="fanswer">Your Secret Answer</label>
                        @Html.TextBoxFor(m => m.SecurityAnswer, new { @class = "form-control", id = "fanswer", placeholder = "Your Answer" })
                        @Html.ValidationMessageFor(m => m.SecurityAnswer, "", new { @class = "text-danger ms-1" })
                    </div>

                    <div class="d-grid pt-3">
                        <button type="submit" class="btn btn-custom d-inline-flex align-items-center justify-content-center gap-3">
                            <span>Verify Answer</span>
                            <i class="bi bi-check-circle-fill fs-2"></i>
                        </button>
                    </div>
                }
            }

            <div class="mt-5 pt-5 border-top border-3 border-light text-center">
                <p class="login-link-container mb-0">
                    Remember your password?
                    @Html.ActionLink("Log In", "Login", "Auth", null, new { @class = "auth-link text-decoration-none" })
                </p>
            </div>

        </div>
    </div>
</div>
