
@model LearningManagement.ViewModels.UserViewModel

@{
    ViewBag.Title = "Edit User";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        --primary-hover: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
        --bg-gradient: radial-gradient(circle at 50% 0%, #eef2ff 0%, #f8fafc 100%);
        --card-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1), 0 0 15px rgba(0, 0, 0, 0.03);
        --icon-bg: #eef2ff;
    }

    body {
        background: var(--bg-gradient);
        min-height: 100vh;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        font-size: 1.4rem; /* Massive baseline font size */
        color: #1e293b;
    }

    .form-wrapper {
        min-height: calc(100vh - 100px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4rem 1rem;
    }

    .card-form {
        background: #ffffff;
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: 36px;
        box-shadow: var(--card-shadow);
        max-width: 860px; /* Widened card */
        width: 100%;
        overflow: hidden;
        transition: transform 0.3s ease;
    }

    .card-header-accent {
        height: 12px;
        background: var(--primary-gradient);
    }

    .form-section {
        padding: 5rem 4.5rem; /* Massive padding */
    }

    /* Icon Badge Container */
    .form-icon-wrapper {
        width: 110px;
        height: 110px;
        background: var(--icon-bg);
        border-radius: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 2.25rem;
    }

        .form-icon-wrapper i {
            font-size: 3.75rem !important;
        }

    .form-header-title {
        font-size: 3.25rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        margin-bottom: 0.75rem;
    }

    .form-header-subtitle {
        font-size: 1.4rem;
        color: #64748b;
    }

    /* Floating Labels & Inputs */
    .form-floating > .form-control,
    .form-floating > .form-select {
        border-radius: 18px;
        border: 2px solid #e2e8f0;
        background-color: #f8fafc;
        height: 86px;
        color: #0f172a;
        font-weight: 700;
        font-size: 1.5rem;
        transition: all 0.2s ease-in-out;
    }

    .form-floating > label {
        color: #64748b;
        padding-left: 1.5rem;
        font-size: 1.35rem;
        padding-top: 1.5rem;
    }

    .form-floating > .form-control:focus,
    .form-floating > .form-select:focus {
        background-color: #ffffff;
        border-color: #6366f1;
        box-shadow: 0 0 0 5px rgba(99, 102, 241, 0.15);
        outline: none;
    }

    /* Readonly styling */
    .form-control[readonly] {
        background-color: #e2e8f0 !important;
        color: #64748b !important;
        border-color: #cbd5e1 !important;
        cursor: not-allowed;
    }

    /* Checkbox Styling */
    .checkbox-massive {
        width: 35px;
        height: 35px;
        border-radius: 8px;
        border: 2px solid #cbd5e1;
        cursor: pointer;
        margin-top: 0.2rem;
        transition: all 0.2s ease;
    }

        .checkbox-massive:checked {
            background-color: #10b981; /* Success Green */
            border-color: #10b981;
        }

    .checkbox-label-massive {
        font-size: 1.4rem;
        font-weight: 800;
        cursor: pointer;
        padding-top: 0.3rem;
    }

    /* Action Buttons */
    .btn-custom-save {
        background: var(--primary-gradient);
        border: none;
        border-radius: 20px;
        padding: 1.5rem 2.75rem;
        font-weight: 800;
        font-size: 1.5rem;
        letter-spacing: 0.02em;
        box-shadow: 0 12px 24px -6px rgba(99, 102, 241, 0.45);
        transition: all 0.25s ease;
        color: #ffffff;
    }

        .btn-custom-save:hover {
            background: var(--primary-hover);
            transform: translateY(-3px);
            box-shadow: 0 16px 28px -6px rgba(99, 102, 241, 0.55);
            color: #ffffff;
        }

    .btn-custom-cancel {
        border-radius: 20px;
        padding: 1.5rem 2.75rem;
        font-weight: 800;
        font-size: 1.5rem;
        border: 3px solid #cbd5e1;
        color: #475569;
        background: #ffffff;
        transition: all 0.2s ease;
    }

        .btn-custom-cancel:hover {
            background: #f1f5f9;
            color: #0f172a;
            border-color: #94a3b8;
        }

    /* Helpers */
    .text-helper {
        font-size: 1.15rem;
        color: #94a3b8;
        font-weight: 500;
        margin-top: 0.5rem;
    }

    .field-validation-error {
        font-size: 1.25rem;
        margin-top: 0.5rem;
        display: block;
        font-weight: 700;
    }

    /* Mobile Responsive Breakpoints */
    @@media (max-width: 991px) {
        .card-form {
            border-radius: 28px;
        }

        .form-section {
            padding: 3.5rem 2.5rem;
        }

        .form-header-title {
            font-size: 2.75rem;
        }

        .action-buttons-container {
            flex-direction: column-reverse;
            gap: 1.5rem;
        }

        .btn-custom-save, .btn-custom-cancel {
            width: 100%;
            text-align: center;
        }
    }

    @@media (max-width: 576px) {
        .form-section {
            padding: 2.5rem 1.5rem;
        }

        .form-floating > .form-control,
        .form-floating > .form-select {
            height: 76px;
            font-size: 1.35rem;
        }

        .form-floating > label {
            font-size: 1.2rem;
            padding-top: 1.1rem;
        }

        .form-header-title {
            font-size: 2.25rem;
        }
    }
</style>

<div class="form-wrapper">
    <div class="card-form">
        <div class="card-header-accent"></div>
        <div class="form-section">

            <!-- Header Section -->
            <div class="text-center mb-5 pb-3">
                <div class="form-icon-wrapper">
                    <i class="bi bi-person-gear text-indigo" style="color: #6366f1;"></i>
                </div>
                <h3 class="form-header-title text-dark">Edit User Profile</h3>
                <p class="text-muted form-header-subtitle mb-0">Update the details and permissions for this user.</p>
            </div>

            @using (Html.BeginForm("Edit", "User", FormMethod.Post, new { id = "editUserForm" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.UserId)

                if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger border-0 rounded-4 py-3 px-4 mb-5 d-flex align-items-center" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-3 fs-2 text-danger"></i>
                        <div class="fw-bold fs-5">
                            @Html.ValidationSummary(true, "Please resolve the highlighted errors below:")
                        </div>
                    </div>
                }

                <!-- Readonly Email Field -->
                <div class="form-floating mb-5">
                    <label for="femail">Email Address</label>
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", id = "femail", @readonly = "readonly" })
                    <div class="text-helper ms-2"><i class="bi bi-lock-fill me-1"></i>Email address cannot be changed.</div>
                </div>

                <!-- Full Name -->
                <div class="form-floating mb-5">
                    <label for="ffullname">Full Name</label>
                    @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", id = "ffullname", placeholder = "Full Name" })
                    <div class="text-helper ms-2">Name is editable.</div>
                    @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger ms-1" })
                    </div>

                <!-- Role Assignment -->
                <div class="form-floating mb-5">
                    <label for="frole">Assigned Role</label>
                    @Html.DropDownListFor(m => m.RoleId, Model.RolesList, "Select a Role", new { @class = "form-select", id = "frole" })
                    @Html.ValidationMessageFor(m => m.RoleId, "", new { @class = "text-danger ms-1" })
                </div>

                <!-- Account Status Checkbox -->
                <div class="mb-5 pb-3">
                    <div class="form-check d-flex align-items-start gap-4 p-0">
                        @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input checkbox-massive flex-shrink-0 m-0", id = "isActiveCheck" })
                        <div>
                            @Html.LabelFor(m => m.IsActive, "Account is Active", new { @class = "form-check-label checkbox-label-massive text-dark", @for = "isActiveCheck" })
                            <div class="text-helper mt-1">Deactivating will immediately prevent the user from logging in.</div>
                        </div>
                    </div>
                </div>

                <!-- Buttons Footer -->
                <div class="d-flex justify-content-between align-items-center action-buttons-container pt-4 border-top border-secondary border-opacity-10 mt-2">
                    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-custom-cancel text-decoration-none" })
                    <button type="submit" class="btn btn-custom-save d-inline-flex align-items-center justify-content-center gap-3">
                        <i class="bi bi-floppy-fill"></i>
                        <span>Save Changes</span>
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.3/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>
}
