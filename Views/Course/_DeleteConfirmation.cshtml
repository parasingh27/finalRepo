@model LearningManagement.Models.Cours

<style>
    /* Modal Container & Content (Massive) */
    .modal-content-custom {
        border-radius: 36px;
        border: none;
        box-shadow: 0 30px 60px -12px rgba(0, 0, 0, 0.25);
        background: #ffffff;
    }

    /* Danger Icon Circle (Massive) */
    .icon-circle-danger {
        width: 110px;
        height: 110px;
        background-color: #fef2f2;
        color: #ef4444;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
    }

    /* Typography (Massive) */
    .delete-modal-title {
        font-size: 3rem;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.02em;
    }

    .delete-modal-text {
        font-size: 1.5rem;
        line-height: 1.6;
        color: #475569;
    }

    /* Warning Note Box (Massive) */
    .warning-note-box {
        background-color: #fffbeb;
        color: #b45309;
        border: 2px dashed #fcd34d;
        border-radius: 20px;
        padding: 1.5rem 1.75rem;
        font-size: 1.35rem;
        text-align: left;
        line-height: 1.5;
    }

    /* Action Buttons (Massive) */
    .btn-cancel-custom {
        border-radius: 20px;
        padding: 1.5rem;
        font-weight: 800;
        font-size: 1.5rem;
        color: #475569;
        background: #f8fafc;
        border: 3px solid #e2e8f0;
        transition: all 0.2s ease;
    }

        .btn-cancel-custom:hover {
            background: #f1f5f9;
            color: #0f172a;
            border-color: #cbd5e1;
        }

    .btn-delete-custom {
        border-radius: 20px;
        padding: 1.5rem;
        font-weight: 800;
        font-size: 1.5rem;
        color: white;
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        border: none;
        box-shadow: 0 12px 24px -6px rgba(239, 68, 68, 0.4);
        transition: all 0.25s ease;
    }

        .btn-delete-custom:hover {
            transform: translateY(-3px);
            box-shadow: 0 16px 28px -6px rgba(239, 68, 68, 0.5);
            color: white;
        }

    /* Close Button (Massive) */
    .btn-close-custom {
        background: #f1f5f9;
        border: none;
        border-radius: 50%;
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #64748b;
        font-weight: bold;
        transition: background 0.2s;
    }

        .btn-close-custom:hover {
            background: #e2e8f0;
            color: #0f172a;
        }

    /* Mobile Breakdown */
    @@media (max-width: 576px) {
        .modal-body-custom {
            padding: 2rem 1.5rem 2.5rem 1.5rem !important;
        }

        .delete-modal-title {
            font-size: 2.25rem;
        }

        .btn-cancel-custom, .btn-delete-custom {
            width: 100%;
        }
    }
</style>

<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document" style="max-width: 600px;">
        <div class="modal-content modal-content-custom">

            <!-- Header (Close Button Only) -->
            <div class="modal-header border-0 pt-4 pe-4 pb-0 d-flex justify-content-end">
                <button type="button" class="btn-close-custom shadow-none" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-x-lg" viewBox="0 0 16 16">
                        <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8 2.146 2.854Z" />
                    </svg>
                </button>
            </div>

            <!-- Body Content -->
            <div class="modal-body modal-body-custom px-5 pb-5 pt-0 text-center">

                <div class="icon-circle-danger mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" fill="currentColor" class="bi bi-exclamation-triangle-fill" viewBox="0 0 16 16">
                        <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
                    </svg>
                </div>

                <h3 class="delete-modal-title mb-3" id="deleteModalLabel">Delete Course?</h3>

                <p class="delete-modal-text mb-4 pb-2">
                    Are you sure you want to permanently remove <br /> <strong class="text-dark fs-3">@Model.CourseName</strong>?
                </p>

                <div class="warning-note-box d-flex align-items-center gap-4 mx-auto mb-5">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-info-circle flex-shrink-0" viewBox="0 0 16 16">
                        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z" />
                        <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533L8.93 6.588zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0z" />
                    </svg>
                    <div>
                        <span class="fw-bolder d-block mb-1 text-uppercase" style="letter-spacing: 0.05em; font-size: 1.1rem;">Important Note:</span>
                        You can only delete this course if it currently has no associated enrollments.
                    </div>
                </div>

                <!-- Form & Actions -->
                @using (Html.BeginForm("Delete", "Course", new { id = Model.CourseId }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="d-flex flex-column flex-sm-row gap-4 justify-content-center mt-3">
                        <button type="button" class="btn btn-cancel-custom flex-grow-1" data-dismiss="modal" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-delete-custom flex-grow-1">Yes, Delete</button>
                    </div>
                }
            </div>

        </div>
    </div>
</div>
