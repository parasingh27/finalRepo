@model LearningManagement.ViewModels.CourseViewModel

@{
    ViewBag.Title = "Create Course";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        --primary-hover: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
        --bg-gradient: radial-gradient(circle at 50% 0%, #eef2ff 0%, #f8fafc 100%);
        --card-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.07), 0 0 10px rgba(0, 0, 0, 0.02);
        --icon-bg: #eef2ff;
    }

    body {
        background: var(--bg-gradient);
        min-height: 100vh;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        font-size: 1.25rem; /* Increased base font size significantly */
        color: #1e293b;
    }

    .form-wrapper {
        min-height: calc(100vh - 100px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4rem 1rem;
    }

    .card-form {
        background: #ffffff;
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: 32px; /* Softer, larger corners */
        box-shadow: var(--card-shadow);
        max-width: 760px; /* Made the card wider to accommodate larger text */
        width: 100%;
        overflow: hidden;
        transition: transform 0.3s ease;
    }

    .card-header-accent {
        height: 10px;
        background: var(--primary-gradient);
    }

    .form-section {
        padding: 4.5rem 4rem; /* Extra padding for breathing room */
    }

    /* Icon Badge Container (Enlarged) */
    .form-icon-wrapper {
        width: 96px;
        height: 96px;
        background: var(--icon-bg);
        border-radius: 28px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 2rem;
    }

        .form-icon-wrapper i {
            font-size: 3rem !important; /* Extra Large Icon */
        }

    .form-header-title {
        font-size: 2.75rem; /* Massive title */
        font-weight: 800;
        letter-spacing: -0.02em;
    }

    .form-header-subtitle {
        font-size: 1.25rem; /* Larger subtitle */
    }

    /* Floating Labels & Inputs (Extra Large) */
    .form-floating > .form-control,
    .form-floating > .form-select {
        border-radius: 16px;
        border: 2px solid #e2e8f0;
        background-color: #f8fafc;
        height: 76px; /* Very tall inputs */
        color: #0f172a;
        font-weight: 600;
        font-size: 1.35rem; /* Extra large input text */
        transition: all 0.2s ease-in-out;
    }

    .form-floating > textarea.form-control {
        height: 180px; /* Much taller textarea */
    }

    .form-floating > label {
        color: #64748b;
        padding-left: 1.25rem;
        font-size: 1.2rem; /* Extra large label text */
        padding-top: 1.25rem; /* Adjusted for taller inputs */
    }

    .form-floating > .form-control:focus,
    .form-floating > .form-select:focus {
        background-color: #ffffff;
        border-color: #6366f1;
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15);
    }

    /* Action Buttons (Extra Large) */
    .btn-custom-create {
        background: var(--primary-gradient);
        border: none;
        border-radius: 16px;
        padding: 1.35rem 2.25rem; /* Thicker, wider padding */
        font-weight: 800;
        font-size: 1.35rem; /* Extra large button text */
        letter-spacing: 0.02em;
        box-shadow: 0 10px 20px -5px rgba(99, 102, 241, 0.45);
        transition: all 0.25s ease;
        color: #ffffff;
    }

        .btn-custom-create:hover {
            background: var(--primary-hover);
            transform: translateY(-2px);
            box-shadow: 0 14px 24px -5px rgba(99, 102, 241, 0.55);
            color: #ffffff;
        }

    .btn-custom-back {
        border-radius: 16px;
        padding: 1.35rem 2.25rem;
        font-weight: 700;
        font-size: 1.3rem; /* Extra large button text */
        border: 2px solid #cbd5e1;
        color: #475569;
        background: #ffffff;
        transition: all 0.2s ease;
    }

        .btn-custom-back:hover {
            background: #f1f5f9;
            color: #0f172a;
            border-color: #94a3b8;
        }

    /* Field Validation Errors */
    .field-validation-error {
        font-size: 1.1rem; /* Highly visible validation text */
        margin-top: 0.4rem;
        display: block;
        font-weight: 600;
    }

    /* Mobile Responsive Breakpoints */
    @@media (max-width: 768px) {
        .card-form {
            border-radius: 24px;
        }

        .form-section {
            padding: 3rem 2rem;
        }

        .form-header-title {
            font-size: 2.25rem;
        }

        .action-buttons-container {
            flex-direction: column-reverse;
            gap: 1.25rem;
        }

        .btn-custom-create, .btn-custom-back {
            width: 100%;
            text-align: center;
        }
    }

    @@media (max-width: 576px) {
        .form-section {
            padding: 2rem 1.25rem;
        }

        .form-floating > .form-control,
        .form-floating > .form-select {
            height: 68px;
            font-size: 1.2rem;
        }

        .form-floating > label {
            font-size: 1.1rem;
            padding-top: 1rem;
        }
    }
</style>

<div class="form-wrapper">
    <div class="card-form">
        <div class="card-header-accent"></div>
        <div class="form-section">

            <!-- Header Section -->
            <div class="text-center mb-5 pb-2">
                <div class="form-icon-wrapper">
                    <i class="bi bi-journal-plus text-indigo" style="color: #6366f1;"></i>
                </div>
                <h3 class="form-header-title text-dark mb-2">Create New Course</h3>
                <p class="text-muted form-header-subtitle mb-0">Fill out the details below to add a course to the catalog</p>
            </div>

            @using (Html.BeginForm("Create", "Course", FormMethod.Post, new { id = "createCourseForm" }))
            {
                @Html.AntiForgeryToken()

                if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger border-0 rounded-4 py-3 px-4 mb-5 d-flex align-items-center" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-3 fs-3 text-danger"></i>
                        <div class="fw-bold fs-5">
                            @Html.ValidationSummary(true, "Please resolve the highlighted errors below:")
                        </div>
                    </div>
                }

                <!-- Course Title -->
                <div class="form-floating mb-4">
                    <label for="fcoursename">Course Title</label>
                    @Html.TextBoxFor(m => m.CourseName, new { @class = "form-control", id = "fcoursename", placeholder = "Course Name" }) 
                    @Html.ValidationMessageFor(m => m.CourseName, "", new { @class = "text-danger ms-1" })
                </div>

                <!-- Category Dropdown -->
                <div class="form-floating mb-4">
                    <label for="fcategory">Category</label>
                    @Html.DropDownListFor(m => m.CategoryId, Model.Categories, "Select a Category", new { @class = "form-select", id = "fcategory" })
                    @Html.ValidationMessageFor(m => m.CategoryId, "", new { @class = "text-danger ms-1" })
                </div>

                <!-- Description Area -->
                <div class="form-floating mb-4">
                    <label for="fdescription">Course Description</label>
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control", id = "fdescription", placeholder = "Description" })
                    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger ms-1" })
                </div>

                <!-- Price Input -->
                <div class="form-floating mb-5">
                    <label for="fprice">Price ($)</label>
                    @Html.TextBoxFor(m => m.Price, new { @class = "form-control", id = "fprice", type = "number", step = "0.01", min = "0", placeholder = "0.00" })
                    @Html.ValidationMessageFor(m => m.Price, "", new { @class = "text-danger ms-1" })
                </div>

                <!-- Buttons Footer -->
                <div class="d-flex justify-content-between align-items-center action-buttons-container pt-3 border-top border-secondary border-opacity-10 mt-5 pt-5">
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-custom-back text-decoration-none" })
                    <button type="submit" class="btn btn-custom-create d-inline-flex align-items-center justify-content-center gap-3">
                        <i class="bi bi-plus-circle-fill"></i>
                        <span>Create Course</span>
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
