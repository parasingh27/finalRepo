@model LearningManagement.ViewModels.CourseListViewModel

@{
    ViewBag.Title = "Course Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        --primary-hover: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
        --danger-gradient: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        --bg-gradient: radial-gradient(circle at 50% 0%, #eef2ff 0%, #f8fafc 100%);
        --card-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1), 0 0 15px rgba(0, 0, 0, 0.03);
    }

    body {
        background: var(--bg-gradient);
        min-height: 100vh;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: #1e293b;
        font-size: 1.4rem; /* Massive baseline font size */
    }

    .management-wrapper {
        padding: 5rem 1rem 7rem 1rem;
    }

    /* Page Header (Massive) */
    .page-title {
        font-size: 3.25rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        color: #0f172a;
    }

    .page-subtitle {
        font-size: 1.5rem;
        color: #64748b;
        margin-top: 0.5rem;
    }

    /* Primary Create Button (Massive) */
    .btn-create-custom {
        background: var(--primary-gradient);
        border: none;
        border-radius: 20px;
        padding: 1.5rem 2.5rem;
        font-weight: 800;
        font-size: 1.4rem;
        color: #ffffff !important;
        box-shadow: 0 12px 24px -6px rgba(99, 102, 241, 0.45);
        transition: all 0.25s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
    }

        .btn-create-custom:hover {
            background: var(--primary-hover);
            transform: translateY(-3px);
            box-shadow: 0 16px 28px -6px rgba(99, 102, 241, 0.55);
            color: #ffffff !important;
        }

    /* Search Bar Control (Massive) */
    .search-box {
        background: #ffffff;
        border-radius: 28px;
        padding: 1.75rem;
        box-shadow: var(--card-shadow);
        border: 1px solid rgba(226, 232, 240, 0.8);
        margin-bottom: 3rem;
    }

    .search-input {
        border-radius: 18px;
        border: 3px solid #e2e8f0;
        background-color: #f8fafc;
        height: 76px; /* Massive input height */
        font-size: 1.4rem; /* Massive text */
        font-weight: 600;
        color: #1e293b;
        padding-left: 1.5rem;
        transition: all 0.2s ease;
    }

        .search-input:focus {
            background-color: #ffffff;
            border-color: #6366f1;
            box-shadow: 0 0 0 5px rgba(99, 102, 241, 0.15);
            outline: none;
        }

    .btn-search-custom {
        border-radius: 16px;
        font-weight: 800;
        font-size: 1.4rem;
        padding: 0 2rem;
        border: 3px solid #e2e8f0;
        color: #475569;
        background: #ffffff;
        transition: all 0.2s ease;
    }

        .btn-search-custom:hover {
            background: #f1f5f9;
            color: #0f172a;
            border-color: #cbd5e1;
        }

    /* Data Table Card (Massive) */
    .card-table-wrapper {
        background: #ffffff;
        border-radius: 32px;
        box-shadow: var(--card-shadow);
        border: 1px solid rgba(226, 232, 240, 0.8);
        overflow: hidden;
        margin-bottom: 3rem;
    }

    .table-custom {
        margin-bottom: 0;
        vertical-align: middle;
    }

        .table-custom thead th {
            background: var(--primary-gradient) !important;
            color: white;
            font-weight: 800;
            font-size: 1.5rem; /* Massive table headers */
            border: none;
            padding: 1.75rem 2rem;
            white-space: nowrap;
        }

        .table-custom thead a {
            color: #ffffff !important;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
        }

            .table-custom thead a:hover {
                color: #e0e7ff !important;
            }

        .table-custom tbody td {
            padding: 1.75rem 2rem; /* Massive row padding */
            color: #334155;
            font-size: 1.4rem; /* Massive row text */
            font-weight: 600;
            border-bottom: 1px solid #f1f5f9;
            background: #ffffff;
            transition: background 0.2s ease;
        }

        .table-custom tbody tr:hover td {
            background: #f8fafc;
        }

    /* Badges */
    .category-badge {
        background: #eef2ff;
        color: #4f46e5;
        border: 2px solid #c7d2fe;
        font-weight: 800;
        font-size: 1.25rem; /* Massive badges */
        padding: 0.6rem 1.35rem;
        border-radius: 30px;
    }

    /* Action Buttons (Table Rows - Massive) */
    .action-btn {
        border-radius: 14px;
        font-weight: 800;
        font-size: 1.25rem; /* Massive action buttons */
        padding: 0.75rem 1.35rem;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
    }

        .action-btn i {
            font-size: 1.35rem; /* Massive icons inside buttons */
        }

        .action-btn:hover {
            transform: translateY(-3px);
        }

    .btn-lessons {
        background: #f0fdf4;
        color: #059669;
        border: 2px solid #a7f3d0;
    }

        .btn-lessons:hover {
            background: #d1fae5;
            color: #047857;
        }

    .btn-add-lesson {
        background: #f0f9ff;
        color: #0284c7;
        border: 2px solid #bae6fd;
    }

        .btn-add-lesson:hover {
            background: #e0f2fe;
            color: #0369a1;
        }

    .btn-edit {
        background: #eef2ff;
        color: #4f46e5;
        border: 2px solid #c7d2fe;
    }

        .btn-edit:hover {
            background: #e0e7ff;
            color: #4338ca;
        }

    .btn-delete {
        background: #fef2f2;
        color: #dc2626;
        border: 2px solid #fecaca;
    }

        .btn-delete:hover {
            background: #fee2e2;
            color: #b91c1c;
        }

    /* Pagination (Massive) */
    .pagination-custom .page-link {
        border-radius: 16px;
        margin: 0 6px;
        color: #4f46e5;
        border: 2px solid #e2e8f0;
        font-weight: 800;
        font-size: 1.4rem; /* Massive pagination numbers */
        padding: 0.85rem 1.5rem;
        transition: all 0.2s ease;
    }

        .pagination-custom .page-link:hover {
            background: #f1f5f9;
            color: #4338ca;
        }

    .pagination-custom .page-item.active .page-link {
        background: var(--primary-gradient);
        border-color: transparent;
        color: white;
        box-shadow: 0 6px 15px rgba(99, 102, 241, 0.3);
    }

    /* Mobile Responsive Breakpoints */
    @@media (max-width: 991px) {
        .page-title {
            font-size: 2.75rem;
        }

        .table-custom tbody td {
            padding: 1.5rem;
        }

        .action-btn {
            padding: 0.75rem 1rem;
            font-size: 1.15rem;
        }

            .action-btn span {
                display: none;
            }
        /* Hide text, keep icons on mobile */
    }

    @@media (max-width: 768px) {
        .management-wrapper {
            padding: 2rem 0.5rem;
        }

        .btn-create-custom {
            width: 100%;
            justify-content: center;
            margin-top: 1.5rem;
        }

        .search-box {
            padding: 1.25rem;
        }

        .search-input {
            height: 64px;
            font-size: 1.25rem;
        }

        .btn-search-custom {
            height: 64px;
            font-size: 1.25rem;
        }
    }
</style>

<div class="container management-wrapper">

    <!-- Top Section & Controls -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-4">
        <div>
            <h2 class="page-title mb-2">Course Management</h2>
            <p class="page-subtitle mb-0">Create, edit, and organize all system courses and lessons.</p>
        </div>
        <div>
            @Html.ActionLink("Create New Course", "Create", null, new { @class = "btn-create-custom" })
        </div>
    </div>

    <!-- Search Bar Row -->
    <div class="search-box">
        @using (Html.BeginForm("Index", "Course", FormMethod.Get, new { @class = "row g-3" }))
        {
            <div class="col-12 col-md-9 col-lg-10">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 rounded-start-4 ms-1 text-muted ps-4 border-3">
                        <i class="bi bi-search" style="font-size: 1.75rem;"></i>
                    </span>
                    @Html.TextBox("searchTerm", Model.SearchTerm, new { @class = "form-control search-input border-start-0 ps-3", placeholder = "Search courses by name..." })
                </div>
            </div>
            <div class="col-12 col-md-3 col-lg-2 d-grid">
                <button type="submit" class="btn btn-search-custom w-100 h-100">Search</button>
            </div>
        }
    </div>

    <!-- Table Container Card -->
    <div class="card-table-wrapper">
        <div class="table-responsive">
            <table class="table table-custom">
                <thead>
                    <tr>
                        <th>
                            @Html.ActionLink("Course Name", "Index", new { sortOrder = Model.SortOrder == "name_desc" ? "" : "name_desc", searchTerm = Model.SearchTerm }, new { @class = "fw-bold" })
                            <i class="bi bi-arrow-down-up ms-2 opacity-75 small fs-4"></i>
                        </th>
                        <th>
                            @Html.ActionLink("Category", "Index", new { sortOrder = Model.SortOrder == "category_asc" ? "category_desc" : "category_asc", searchTerm = Model.SearchTerm }, new { @class = "fw-bold" })
                            <i class="bi bi-arrow-down-up ms-2 opacity-75 small fs-4"></i>
                        </th>
                        <th class="text-end pe-5">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Courses != null && Model.Courses.Any())
                    {
                        foreach (var item in Model.Courses)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@item.CourseName</td>
                                <td>
                                    <span class="category-badge">@item.CategoryName</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-3 flex-wrap">

                                        <a href="@Url.Action("Index", "Lesson", new { courseId = item.CourseId })" class="action-btn btn-lessons" title="View Lessons">
                                            <i class="bi bi-collection-play-fill"></i>
                                            <span>Lessons</span>
                                        </a>

                                        <a href="@Url.Action("Create", "Lesson", new { courseId = item.CourseId })" class="action-btn btn-add-lesson" title="Add Lesson">
                                            <i class="bi bi-plus-square-fill"></i>
                                            <span>Add Lesson</span>
                                        </a>

                                        <a href="@Url.Action("Edit", new { id = item.CourseId })" class="action-btn btn-edit" title="Edit Course">
                                            <i class="bi bi-pencil-square"></i>
                                            <span>Edit</span>
                                        </a>

                                        <button type="button" class="action-btn btn-delete" onclick="loadDeleteModal(@item.CourseId)" title="Delete Course">
                                            <i class="bi bi-trash3-fill"></i>
                                            <span>Delete</span>
                                        </button>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-5">
                                <div class="text-muted d-flex flex-column align-items-center justify-content-center my-5">
                                    <i class="bi bi-search mb-4 opacity-50" style="font-size: 4rem !important;"></i>
                                    <span class="fs-3 fw-semibold">No courses found matching your criteria.</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav class="d-flex justify-content-center mt-5 pt-3">
            <ul class="pagination pagination-custom">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        @Html.ActionLink(i.ToString(), "Index", new { page = i, sortOrder = Model.SortOrder, searchTerm = Model.SearchTerm }, new { @class = "page-link shadow-none" })
                    </li>
                }
            </ul>
        </nav>
    }
</div>

<!-- Modal Container (Dynamically Loaded) -->
<div id="deleteModalContainer"></div>
@section scripts {
    <script>
        function loadDeleteModal(courseId) {

            console.log("Loading delete confirmation for Course ID: " + courseId);

            $.ajax({
                url: '@Url.Action("DeleteConfirmation", "Course")',
                type: 'GET',
                data: { id: courseId },

                success: function (data) {

                    console.log("Delete confirmation loaded successfully.");

                    $('#deleteModalContainer').html(data);

                    var modal = $('#deleteModal');

                    if (modal.length === 0) {
                        console.error("deleteModal was not found.");
                        return;
                    }

                    /*
                     * Bootstrap 3
                     */
                    if ($.fn.modal) {
                        modal.modal('show');
                    }
                    else {
                        /*
                         * Fallback if Bootstrap JavaScript is not loaded.
                         * This prevents the bootstrap is not defined error.
                         */
                        modal.css({
                            'display': 'block',
                            'padding-right': '17px'
                        });

                        modal.addClass('in');
                        modal.attr('aria-hidden', 'false');

                        $('body').addClass('modal-open');

                        if ($('.modal-backdrop').length === 0) {
                            $('<div class="modal-backdrop fade in"></div>')
                                .appendTo('body');
                        }

                        console.log("Modal opened using fallback.");
                    }
                },

                error: function (xhr, status, error) {

                    console.error("AJAX failed.");
                    console.error("Status:", status);
                    console.error("Error:", error);
                    console.error("Response:", xhr.responseText);

                    alert("Could not load delete confirmation.");
                }
            });
        }
    </script>
}