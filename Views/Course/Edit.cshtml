@model LearningManagement.ViewModels.CourseViewModel

@{
    ViewBag.Title = "Edit Course";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        --primary-hover: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
        --bg-gradient: radial-gradient(circle at 50% 0%, #eef2ff 0%, #f8fafc 100%);
        --card-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1), 0 0 15px rgba(0, 0, 0, 0.03);
        --icon-bg: #eef2ff;
    }

    body {
        background: var(--bg-gradient);
        min-height: 100vh;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        font-size: 1.4rem; /* Massive baseline font size */
        color: #1e293b;
    }

    .form-wrapper {
        min-height: calc(100vh - 100px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4rem 1rem;
    }

    .card-form {
        background: #ffffff;
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: 36px; /* Larger, softer corners */
        box-shadow: var(--card-shadow);
        max-width: 860px; /* Widened card for massive text */
        width: 100%;
        overflow: hidden;
        transition: transform 0.3s ease;
    }

    .card-header-accent {
        height: 12px;
        background: var(--primary-gradient);
    }

    .form-section {
        padding: 5rem 4.5rem; /* Massive padding */
    }

    /* Icon Badge Container (Massive) */
    .form-icon-wrapper {
        width: 110px;
        height: 110px;
        background: var(--icon-bg);
        border-radius: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 2.25rem;
    }

        .form-icon-wrapper i {
            font-size: 3.75rem !important; /* Massive Icon */
        }

    .form-header-title {
        font-size: 3.25rem; /* Ultra-large title */
        font-weight: 800;
        letter-spacing: -0.03em;
        margin-bottom: 0.75rem;
    }

    .form-header-subtitle {
        font-size: 1.4rem; /* Ultra-large subtitle */
    }

    /* Floating Labels & Inputs (Ultra Large) */
    .form-floating > .form-control,
    .form-floating > .form-select {
        border-radius: 18px;
        border: 2px solid #e2e8f0;
        background-color: #f8fafc;
        height: 86px; /* Massive inputs */
        color: #0f172a;
        font-weight: 700;
        font-size: 1.5rem; /* Ultra-large input text */
        transition: all 0.2s ease-in-out;
    }

    .form-floating > textarea.form-control {
        height: 220px; /* Massive textarea */
    }

    .form-floating > label {
        color: #64748b;
        padding-left: 1.5rem;
        font-size: 1.35rem; /* Ultra-large label text */
        padding-top: 1.5rem; /* Adjusted for taller inputs */
    }

    .form-floating > .form-control:focus,
    .form-floating > .form-select:focus {
        background-color: #ffffff;
        border-color: #6366f1;
        box-shadow: 0 0 0 5px rgba(99, 102, 241, 0.15);
    }

    /* Action Buttons (Ultra Large) */
    .btn-custom-save {
        background: var(--primary-gradient);
        border: none;
        border-radius: 20px;
        padding: 1.5rem 2.75rem; /* Massive padding */
        font-weight: 800;
        font-size: 1.5rem; /* Ultra-large button text */
        letter-spacing: 0.02em;
        box-shadow: 0 12px 24px -6px rgba(99, 102, 241, 0.45);
        transition: all 0.25s ease;
        color: #ffffff;
    }

        .btn-custom-save:hover {
            background: var(--primary-hover);
            transform: translateY(-3px);
            box-shadow: 0 16px 28px -6px rgba(99, 102, 241, 0.55);
            color: #ffffff;
        }

    .btn-custom-cancel {
        border-radius: 20px;
        padding: 1.5rem 2.75rem;
        font-weight: 800;
        font-size: 1.5rem; /* Ultra-large button text */
        border: 3px solid #cbd5e1;
        color: #475569;
        background: #ffffff;
        transition: all 0.2s ease;
    }

        .btn-custom-cancel:hover {
            background: #f1f5f9;
            color: #0f172a;
            border-color: #94a3b8;
        }

    /* Field Validation Errors */
    .field-validation-error {
        font-size: 1.25rem; /* Ultra-large validation text */
        margin-top: 0.5rem;
        display: block;
        font-weight: 700;
    }

    /* Mobile Responsive Breakpoints */
    @@media (max-width: 991px) {
        .card-form {
            border-radius: 28px;
        }

        .form-section {
            padding: 3.5rem 2.5rem;
        }

        .form-header-title {
            font-size: 2.75rem;
        }

        .action-buttons-container {
            flex-direction: column-reverse;
            gap: 1.5rem;
        }

        .btn-custom-save, .btn-custom-cancel {
            width: 100%;
            text-align: center;
        }
    }

    @@media (max-width: 576px) {
        .form-section {
            padding: 2.5rem 1.5rem;
        }

        .form-floating > .form-control,
        .form-floating > .form-select {
            height: 76px;
            font-size: 1.35rem;
        }

        .form-floating > label {
            font-size: 1.2rem;
            padding-top: 1.1rem;
        }

        .form-header-title {
            font-size: 2.25rem;
        }
    }
</style>

<div class="form-wrapper">
    <div class="card-form">
        <div class="card-header-accent"></div>
        <div class="form-section">

            <!-- Header Section -->
            <div class="text-center mb-5 pb-3">
                <div class="form-icon-wrapper">
                    <i class="bi bi-pencil-square text-indigo" style="color: #6366f1;"></i>
                </div>
                <h3 class="form-header-title text-dark">Edit Course</h3>
                <p class="text-muted form-header-subtitle mb-0">Update the details of the course below.</p>
            </div>

            @using (Html.BeginForm("Edit", "Course", FormMethod.Post, new { id = "editCourseForm" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.CourseId)

                if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger border-0 rounded-4 py-3 px-4 mb-5 d-flex align-items-center" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-3 fs-2 text-danger"></i>
                        <div class="fw-bold fs-5">
                            @Html.ValidationSummary(true, "Please resolve the highlighted errors below:")
                        </div>
                    </div>
                }

                <!-- Course Title -->
                <div class="form-floating mb-4">
                    <label for="fcoursename">Course Title</label>
                    @Html.TextBoxFor(m => m.CourseName, new { @class = "form-control", id = "fcoursename", placeholder = "Course Name" })
                    @Html.ValidationMessageFor(m => m.CourseName, "", new { @class = "text-danger ms-1" })
                </div>

                <!-- Category Dropdown -->
                <div class="form-floating mb-4">
                    <label for="fcategory">Category</label>
                    @Html.DropDownListFor(m => m.CategoryId, Model.Categories, "Select a Category", new { @class = "form-select", id = "fcategory" })
                    @Html.ValidationMessageFor(m => m.CategoryId, "", new { @class = "text-danger ms-1" })
                </div>

                <!-- Description Area -->
                <div class="form-floating mb-4">
                    <label for="fdescription">Course Description</label>
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control", id = "fdescription", placeholder = "Description" }) 
                    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger ms-1" })
                </div>

                <!-- Price Input -->
                <div class="form-floating mb-5 pb-3">
                    <label for="fprice">Price ($)</label>
                    @Html.TextBoxFor(m => m.Price, new { @class = "form-control", id = "fprice", type = "number", step = "0.01", min = "0", placeholder = "0.00" })
                    @Html.ValidationMessageFor(m => m.Price, "", new { @class = "text-danger ms-1" })
                </div>

                <!-- Buttons Footer -->
                <div class="d-flex justify-content-between align-items-center action-buttons-container pt-4 border-top border-secondary border-opacity-10 mt-5">
                    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-custom-cancel text-decoration-none" })
                    <button type="submit" class="btn btn-custom-save d-inline-flex align-items-center justify-content-center gap-3">
                        <i class="bi bi-floppy-fill"></i>
                        <span>Save Changes</span>
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
